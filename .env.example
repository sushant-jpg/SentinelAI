# Run python3 scripts/configure.py to generate a working local .env.
ENVIRONMENT=development
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai
POSTGRES_PASSWORD=
# Local backend uses SQLite unless DATABASE_URL is set. Compose supplies PostgreSQL.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/sentinelai
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@sentinelai.local
BOOTSTRAP_ADMIN_PASSWORD=
INGEST_API_KEY=
DEMO_MODE=true
REGISTRATION_ENABLED=true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AI_PROVIDER=local
# Optional HTTPS OpenAI-compatible chat-completions endpoint.
AI_API_URL=
AI_API_KEY=
AI_MODEL=
